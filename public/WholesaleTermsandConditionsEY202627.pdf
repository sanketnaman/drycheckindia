    color: white;
}
.dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #5436ba;
    padding: 20px 40px;
    width: 300px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    z-index: 200;
    white-space: nowrap;
    border-radius: 4px;
}
    .dropdown-menu li {
        padding: 10px 0;
        color: white; 
        list-style-type: disc; 
        list-style-position: outside;
        margin-left: 20px;
        cursor: pointer;
    }

    .dropdown-menu a {
        color: white;
        text-decoration: none;
        padding: 5px 0; 
        display: block;
        transition: background-color 0.3s ease;
        cursor: pointer; 
    }
        .dropdown-menu a:hover {
            background-color: #823b1f;
            color:white;
        }
.dropdown:hover .dropdown-menu,
.dropdown-trigger:hover + .dropdown-menu {
    display: block;
}
