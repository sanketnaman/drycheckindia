# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_SITE_URL: The canonical URL where this app is hosted.
# Used for metadata, canonical links, OpenGraph, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://drycheck.in"

# APP_URL: The URL where this applet is hosted in AI Studio preview.
APP_URL="https://drycheck.in"

# NEXT_PUBLIC_ADS_ENABLED: Set to "true" to enable compliant ad placeholder slots.
# Defaults to disabled (renders nothing) when unset or "false".
NEXT_PUBLIC_ADS_ENABLED="false"

# ---------------------------------------------------------------------------
# Supabase (Phase 2 — database foundation)
# Placeholders only. Copy to .env.local and replace with real project values.
# Never commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SUPABASE_URL: Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Browser-safe anon/publishable key
# (Settings → API → publishable/anon key). Safe for client bundles.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret role key.
# NEVER import this in client components, NEXT_PUBLIC_* vars, or browser code.
# Used only by trusted server routes (not wired in Phase 2).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------------------
# Public data source
# The public site ALWAYS reads published dry-day entries from Supabase using
# the two NEXT_PUBLIC_* variables above. There is no JSON fallback: if the
# database is unconfigured, empty or unreachable, pages render the explicit
# "No verified dry-day entries published yet" empty state.
# ---------------------------------------------------------------------------
