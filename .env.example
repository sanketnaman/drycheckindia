# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_SITE_URL: The canonical URL where this app is hosted.
# Used for metadata, canonical links, OpenGraph, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://drycheck.in"

# APP_URL: The URL where this applet is hosted in AI Studio preview.
APP_URL="https://drycheck.in"

# NEXT_PUBLIC_ADS_ENABLED: Set to "true" to enable compliant ad placeholder slots.
# Defaults to disabled (renders nothing) when unset or "false".
NEXT_PUBLIC_ADS_ENABLED="false"
